# Site metadata (verification & password-reset links)
SITE_URL=http://127.0.0.1:8000
SITE_NAME=sketches101

# Django — required in production (PythonAnywhere)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Production example (PythonAnywhere):
# DEBUG=false
# ALLOWED_HOSTS=www.sketches101.com,sketches101.com,yourusername.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://www.sketches101.com,https://sketches101.com
# SITE_URL=https://www.sketches101.com
# After deploy: pip install -r requirements.txt && python manage.py collectstatic --noinput
# Map /static/ -> .../staticfiles in the Web tab, or rely on WhiteNoise via WSGI.

# Database — omit DB_ENGINE (or set sqlite) for local SQLite.
# On PythonAnywhere MySQL (values from the Databases tab):
# DB_ENGINE=mysql
# DB_NAME=yourusername$sketches101
# DB_USER=yourusername
# DB_PASSWORD=your-mysql-password
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_PORT=3306
# Optional — create this DB on the Databases tab before running tests on PA:
# DB_TEST_NAME=yourusername$test_sketches101

# Optional — Google Identity Services (same Web client ID on both sides)
# GOOGLE_OAUTH_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Frontend build (frontend/.env.local or Vite env on build machine):
# VITE_GOOGLE_OAUTH_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Live sketch previews use a file-based Django cache under .cache/django/
# (shared across workers). Ensure the web app can write that directory.
# SMTP — optional; leave EMAIL_HOST empty to print emails to the console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
