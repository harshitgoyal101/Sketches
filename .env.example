# Site metadata (verification & password-reset links)
SITE_URL=http://127.0.0.1:8000
SITE_NAME=sketches101

# Django — required in production (PythonAnywhere)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Production example (PythonAnywhere):
# DEBUG=false
# ALLOWED_HOSTS=yourusername.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
# SITE_URL=https://yourusername.pythonanywhere.com

# SMTP — optional; leave EMAIL_HOST empty to print emails to the console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
